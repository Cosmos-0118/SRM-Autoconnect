<Window x:Class="SRMAutoconnect.Views.MainPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRM Autoconnect"
        Width="300"
        Height="400"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Background="Black">
    <Border BorderBrush="#66CCFF99"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SRM AUTOCONNECT"
                           HorizontalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#33FF59" />
                <TextBlock Text="Windows scaffold ready"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#88FF99" />
                <TextBlock Text="Dashboard, Logs, and Settings will be added in Phase 1."
                           Margin="0,18,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#66FF88" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
