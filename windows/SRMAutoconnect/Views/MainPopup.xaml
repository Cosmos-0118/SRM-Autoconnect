<Window x:Class="SRMAutoconnect.Views.MainPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:SRMAutoconnect.Helpers"
        xmlns:views="clr-namespace:SRMAutoconnect.Views"
        Title="SRM Autoconnect"
        Width="300"
        Height="400"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Background="Black">
    <Border BorderBrush="{x:Static helpers:Theme.PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid>
            <Grid Background="{x:Static helpers:Theme.BackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="58" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="SelectedContent" Grid.Row="0" />

                <Rectangle Grid.Row="1"
                           Fill="{x:Static helpers:Theme.PanelBorderBrush}"
                           Opacity="0.45" />

                <Grid Grid.Row="2" Background="{x:Static helpers:Theme.BackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="DashboardTab"
                            Grid.Column="0"
                            Click="DashboardTab_Click"
                            Content="DASHBOARD"
                            Style="{StaticResource TerminalButton}" />
                    <Button x:Name="LogsTab"
                            Grid.Column="1"
                            Click="LogsTab_Click"
                            Content="LOGS"
                            Style="{StaticResource TerminalButton}" />
                    <Button x:Name="SettingsTab"
                            Grid.Column="2"
                            Click="SettingsTab_Click"
                            Content="SETTINGS"
                            Style="{StaticResource TerminalButton}" />
                </Grid>
            </Grid>

            <views:ScanlineOverlay />
        </Grid>
    </Border>
</Window>
