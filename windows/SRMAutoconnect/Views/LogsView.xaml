<UserControl x:Class="SRMAutoconnect.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:SRMAutoconnect.Core"
             xmlns:helpers="clr-namespace:SRMAutoconnect.Helpers">
    <Grid Margin="14,22,14,12" Background="{x:Static helpers:Theme.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ACTIVITY LOGS"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{x:Static helpers:Theme.GreenBrush}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock x:Name="ActionNote"
                           Margin="0,3,10,0"
                           FontSize="10"
                           Foreground="{x:Static helpers:Theme.GreenBrush}"
                           Visibility="Collapsed" />
                <Button Width="30"
                        Content="CP"
                        Click="CopyLogs_Click"
                        Style="{StaticResource TerminalButton}"
                        ToolTip="Copy logs" />
                <Button Width="30"
                        Margin="6,0,0,0"
                        Content="CL"
                        Click="ClearLogs_Click"
                        Style="{StaticResource TerminalButton}"
                        ToolTip="Clear logs" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource TerminalPanel}">
            <Grid>
                <TextBlock x:Name="EmptyLogText"
                           Text="NO LOGS YET."
                           FontSize="12"
                           Foreground="{x:Static helpers:Theme.DimGreenBrush}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:LogEntry}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="11"
                                               Foreground="{x:Static helpers:Theme.GreenBrush}"
                                               TextWrapping="Wrap" />
                                    <Separator Margin="0,6"
                                               Background="{x:Static helpers:Theme.PanelBorderBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
